# Example only. Generate fresh secrets outside Git; do not copy live values here.
NODE_ENV=production
SERVER_ORIGIN=https://crm.skuaspestcontrol.com
# At least 32 random characters; rotate existing sessions after credential exposure.
PORTAL_AUTH_SECRET=
PORTAL_AUTH_TTL_MS=43200000
# Host-only cookies by default; configure a wider domain only if required.
PORTAL_AUTH_COOKIE_DOMAIN=
# Confirm Hostinger's actual proxy addresses before changing this.
TRUST_PROXY=loopback
CORS_ALLOWED_ORIGINS=https://crm.skuaspestcontrol.com,https://api.skuaspestcontrol.com
# A private persistent directory OUTSIDE public_html and the source checkout.
UPLOADS_ROOT=/private/persistent/path/to/uploads
# Leave blank unless the mirror is also private and served through Node authorization.
UPLOADS_MIRROR_DIR=
SMTP_ENCRYPTION_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY=
MASTER_RESET_EMAIL=
# Browser-restricted Maps key; do not reuse an unrestricted server geocoding key.
GOOGLE_MAPS_BROWSER_API_KEY=
